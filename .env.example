# 复制此文件为 .env 并填入真实值
# .env 文件已在 .gitignore 中，不会被提交到仓库

# DeepSeek API 密钥（用于 LLM 调用）
DEEPSEEK_API_KEY=sk-your-api-key-here

# 飞书机器人 Webhook 地址（用于测试报告推送）
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-webhook-id-here

# Playwright 浏览器安装路径（默认在 C 盘用户目录，可改到其他盘节省 C 盘空间）
# 示例：PLAYWRIGHT_BROWSERS_PATH=D:\Test_Ai_agent_project\.browsers
# 设置后需重新运行：npx playwright install chromium
PLAYWRIGHT_BROWSERS_PATH=
