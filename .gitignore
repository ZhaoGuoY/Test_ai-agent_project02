# ====================== 1. 依赖目录 ======================
node_modules/       # Node.js 依赖（npm/yarn/pnpm 安装的包）
.venv/              # Python 虚拟环境
__pycache__/        # Python 字节码缓存（.pyc 文件）
*.py[cod]           # Python 编译后的文件（.pyc/.pyo/.pyd）

# ====================== 2. 测试产物 ======================
workspace/test-results/  # Playwright 测试结果（如 JSON/XML 报告）
workspace/logs/         # 日志文件（如 monitor.log）
workspace/*.py          # Agent 生成的临时脚本（如 check_*.py、run_*.py）
playwright-report/      # Playwright HTML 报告
check_*.py             # Agent 生成的临时检查脚本
run_*.py               # Agent 生成的临时运行脚本
final_*.py             # Agent 生成的临时最终脚本
conversation_history/   # LangGraph 对话历史（checkpoint 持久化）
.langgraph_api/         # LangGraph 内部状态

# ====================== 3. 环境变量 / 密钥 ======================
.env                # 环境变量文件（含敏感信息，如 API Key）
*.local             # 本地配置文件（如 .env.local）

# ====================== 4. IDE 配置 ======================
.idea/              # PyCharm 项目配置
.vscode/            # VS Code 配置（settings.json、launch.json 等）

# ====================== 5. 打包输出（可选） ======================
dist/               # 前端打包产物（如 React/Vue 项目）
build/              # Python 打包产物（如 `python setup.py sdist` 生成的文件）
*.exe               # 可执行文件（如 PyInstaller 打包的程序）
*.dll               # 动态链接库（Windows）
*.so                # 动态链接库（Linux/macOS）

# ====================== 6. 系统文件 ======================
.DS_Store           # macOS 系统文件
Thumbs.db           # Windows 缩略图缓存